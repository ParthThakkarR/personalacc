PORT=8080
DB_PATH=./data/khata.db
# Production: generate with `node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"`
# Must be >= 32 chars. Server refuses to start in production without it.
JWT_SECRET=change-me-in-prod-min-32-chars
# At-rest field encryption key (AES-256-GCM, see src/utils/cipher.js).
# Required in production; dev falls back to a JWT_SECRET-derived key.
# CIPHER_KEY=change-me-too-min-32-chars-distinct-from-jwt
ACCESS_EXPIRES=15m
REFRESH_DAYS=30
# Password login is the active mode (zero SMS cost). Same number + password
# on any device syncs the same books (account-based sync).
AUTH_MODE=password
# Browser origins allowed to call the API (native app sends no Origin).
# ALLOWED_ORIGINS=https://your-domain
# 0 after the first real account exists; demo seed is LAN-demo only.
SEED_DEMO=1
# --- OTP/SMS seam (PARKED) ---
# Re-enable when an SMS provider (Firebase Phone Auth / MSG91 / Truecaller)
# is funded. NEVER enable demo OTP on a public server: anyone could log in
# as anyone.
# ALLOW_DEMO_OTP=1
# OTP_FIXED=123456
